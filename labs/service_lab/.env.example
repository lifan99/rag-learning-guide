# Copy values into your shell; service.py does not load .env files automatically.
# Obtain matching workspace, region, endpoint, and API key from Model Studio.
DASHSCOPE_API_KEY=replace-with-your-api-key
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIM=1024
RAG_CHAT_MODEL=qwen-plus
RAG_RERANK=0
RAG_RERANK_MODEL=qwen3-rerank
RAG_RETRIEVAL=hybrid
RAG_GROUPS=employee
RAG_TIMEOUT=20
RAG_CONTEXT_CHARS=5000
# An empty MILVUS_URI uses .state/milvus.db via Milvus Lite.
MILVUS_URI=
